# Runtime
NODE_ENV=development
PORT=3001

# URL of the web client (CORS origin + OAuth redirect target)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build the Spotify redirect URI)
SERVER_URL=http://localhost:3001

# Spotify Dashboard: https://developer.spotify.com/dashboard
# Register redirect URI: ${SERVER_URL}/api/auth/callback
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (SQLite file, relative to the server folder)
DB_FILENAME=./db.sqlite3
